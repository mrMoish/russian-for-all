---
import { type Locale } from '../i18n/languages';
import { getTranslation } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);

const letters = [
  { ru: 'А а', trans: 'A', sound: 'fAther' },
  { ru: 'Б б', trans: 'B', sound: 'Boy' },
  { ru: 'В в', trans: 'V', sound: 'Voice' },
  { ru: 'Г г', trans: 'G', sound: 'Go' },
  { ru: 'Д д', trans: 'D', sound: 'Door' },
  { ru: 'Е е', trans: 'Ye / E', sound: 'Yes' },
  { ru: 'Ё ё', trans: 'Yo', sound: 'Yonder' },
  { ru: 'Ж ж', trans: 'Zh', sound: 'pleaSure' },
  { ru: 'З з', trans: 'Z', sound: 'Zoo' },
  { ru: 'И и', trans: 'I', sound: 'mEet' },
  { ru: 'Й й', trans: 'Y', sound: 'boY' },
  { ru: 'К к', trans: 'K', sound: 'Kite' },
  { ru: 'Л л', trans: 'L', sound: 'Love' },
  { ru: 'М м', trans: 'M', sound: 'Moon' },
  { ru: 'Н н', trans: 'N', sound: 'Name' },
  { ru: 'О о', trans: 'O', sound: 'More' },
  { ru: 'П п', trans: 'P', sound: 'Park' },
  { ru: 'Р р', trans: 'R', sound: 'Rolled R' },
  { ru: 'С с', trans: 'S', sound: 'Sun' },
  { ru: 'Т т', trans: 'T', sound: 'Time' },
  { ru: 'У у', trans: 'U', sound: 'bOOt' },
  { ru: 'Ф ф', trans: 'F', sound: 'Fast' },
  { ru: 'Х х', trans: 'Kh / H', sound: 'loCh' },
  { ru: 'Ц ц', trans: 'Ts', sound: 'caTs' },
  { ru: 'Ч ч', trans: 'Ch', sound: 'CHair' },
  { ru: 'Ш ш', trans: 'Sh', sound: 'SHip' },
  { ru: 'Щ щ', trans: 'Shch', sound: 'freSH CHeese' },
  { ru: 'Ъ ъ', trans: 'Hard Sign', sound: 'Silent pause' },
  { ru: 'Ы ы', trans: 'Y', sound: 'i in rIthm' },
  { ru: 'Ь ь', trans: 'Soft Sign', sound: 'Softens prev' },
  { ru: 'Э э', trans: 'E', sound: 'pEt' },
  { ru: 'Ю ю', trans: 'Yu', sound: 'Yule' },
  { ru: 'Я я', trans: 'Ya', sound: 'YArd' },
];
---

<div class="bg-white dark:bg-slate-800 rounded-2xl p-6 sm:p-8 shadow-md border border-slate-200 dark:border-slate-700">
  <div class="max-w-3xl mb-6">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{t.cyrillic.title}</h3>
    <p class="text-sm text-slate-600 dark:text-slate-300 mb-3">{t.cyrillic.subtitle}</p>
    <p class="text-xs text-brand-700 dark:text-brand-400 bg-brand-50 dark:bg-slate-900/50 p-3 rounded-lg border border-brand-100 dark:border-slate-800">
      {t.cyrillic.intro}
    </p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
    {letters.map((item) => (
      <div class="p-3 bg-slate-50 dark:bg-slate-900/60 rounded-xl border border-slate-200/80 dark:border-slate-700/80 text-center hover:border-brand-500 transition">
        <div class="text-xl font-bold text-brand-600 dark:text-brand-400 font-serif">{item.ru}</div>
        <div class="text-xs font-semibold text-slate-700 dark:text-slate-200">{item.trans}</div>
        <div class="text-[10px] text-slate-400 dark:text-slate-500 truncate">{item.sound}</div>
      </div>
    ))}
  </div>
</div>
