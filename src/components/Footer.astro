---
import { type Locale } from '../i18n/languages';
import { getTranslation } from '../i18n/utils';
import { CONTACTS, BRAND_NAME } from '../config/contacts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 pt-12 pb-24 md:pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">

      <!-- Brand summary -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2 text-xl font-bold text-white">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-md bg-brand-600 text-white font-serif font-extrabold text-lg">М</span>
          <span>{BRAND_NAME}</span>
        </div>
        <p class="text-sm text-slate-400 max-w-sm">
          {t.footer.tagline}
        </p>
        <p class="text-xs text-slate-500 italic">
          {t.footer.noCookiesNote}
        </p>
      </div>

      <!-- Quick Nav -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">
          {t.footer.quickLinks}
        </h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`/${locale}/`} class="hover:text-white transition">{t.nav.home}</a></li>
          <li><a href={`/${locale}/why-speaking-works/`} class="hover:text-white transition">{t.nav.whySpeaking}</a></li>
          <li><a href={`/${locale}/how-lessons-work/`} class="hover:text-white transition">{t.nav.format}</a></li>
          <li><a href={`/${locale}/learn-russian/`} class="hover:text-white transition">{t.nav.guideHub}</a></li>
          <li><a href={`/${locale}/about/`} class="hover:text-white transition">{t.nav.about}</a></li>
          <li><a href={`/${locale}/privacy/`} class="hover:text-white transition">{t.nav.privacy}</a></li>
        </ul>
      </div>

      <!-- Direct Contacts -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">
          {t.footer.contactTitle}
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={CONTACTS.telegram} target="_blank" rel="noopener" data-contact="telegram-footer" class="hover:text-white transition flex items-center gap-2">
              <span class="text-sky-400">Telegram:</span> @mr_Moish
            </a>
          </li>
          <li>
            <a href={CONTACTS.whatsapp} target="_blank" rel="noopener" data-contact="whatsapp-footer" class="hover:text-white transition flex items-center gap-2">
              <span class="text-emerald-400">WhatsApp:</span> +54 11 2179-8231
            </a>
          </li>
          <li>
            <a href={CONTACTS.instagram} target="_blank" rel="noopener" data-contact="instagram-footer" class="hover:text-white transition flex items-center gap-2">
              <span class="text-pink-400">Instagram:</span> @mr_moish
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>&copy; {year} {BRAND_NAME} ({CONTACTS.ownerName}). {t.footer.rights}</p>
      <div class="flex items-center gap-4">
        <a href={`/${locale}/privacy/`} class="hover:underline">{t.footer.privacy}</a>
        <span>•</span>
        <span>Buenos Aires, Argentina</span>
      </div>
    </div>
  </div>
</footer>
