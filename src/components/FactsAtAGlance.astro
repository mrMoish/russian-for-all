---
import { type Locale } from '../i18n/languages';
import { getTranslation } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);

const facts = [
  { label: t.facts.ownerLabel, value: t.facts.ownerValue },
  { label: t.facts.locationLabel, value: t.facts.locationValue },
  { label: t.facts.serviceLabel, value: t.facts.serviceValue },
  { label: t.facts.levelsLabel, value: t.facts.levelsValue },
  { label: t.facts.languagesLabel, value: t.facts.languagesValue },
  { label: t.facts.platformsLabel, value: t.facts.platformsValue },
];
---

<div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 shadow-xl border border-slate-800">
  <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-800">
    <div class="w-3 h-3 rounded-full bg-brand-500 animate-pulse"></div>
    <h3 class="text-xl font-bold text-white">{t.facts.title}</h3>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {facts.map((fact) => (
      <div class="p-4 bg-slate-800/80 rounded-xl border border-slate-700/60">
        <div class="text-xs font-semibold text-brand-400 uppercase tracking-wider mb-1">
          {fact.label}
        </div>
        <div class="text-sm sm:text-base font-medium text-slate-100">
          {fact.value}
        </div>
      </div>
    ))}
  </div>
</div>
