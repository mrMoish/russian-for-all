---
import { LANGUAGES, type Locale } from '../i18n/languages';
import { getTranslation, getLanguageInfo } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBottomBar from '../components/StickyBottomBar.astro';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogImage?: string;
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const { locale, title, description, ogImage = '/og-default.png', articleMeta, breadcrumbs } = Astro.props;
const langInfo = getLanguageInfo(locale);
const t = getTranslation(locale);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Build hreflang links
const pathnameWithoutLang = Astro.url.pathname.replace(/^\/(en|zh|es|tr|ar|ro|he)/, '');
---

<!DOCTYPE html>
<html lang={langInfo.hreflang} dir={langInfo.dir} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Hreflang annotations -->
  {Object.values(LANGUAGES).map((lang) => (
    <link
      rel="alternate"
      hreflang={lang.hreflang}
      href={new URL(`/${lang.code}${pathnameWithoutLang}`, Astro.site)}
    />
  ))}
  <link
    rel="alternate"
    hreflang="x-default"
    href={new URL(`/en${pathnameWithoutLang}`, Astro.site)}
  />

  <!-- Favicon & Manifest -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- OpenGraph / Social -->
  <meta property="og:type" content={articleMeta ? "article" : "website"} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={t.header.brandName} />
  <meta property="og:locale" content={langInfo.hreflang} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

  {articleMeta?.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
  {articleMeta?.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
  {articleMeta?.author && <meta property="article:author" content={articleMeta.author} />}

  <!-- Structured Data JSON-LD -->
  <StructuredData
    locale={locale}
    canonicalURL={canonicalURL}
    breadcrumbs={breadcrumbs}
  />

  <!-- Preload fonts if applicable -->
  <style is:global>
    body {
      font-family: 'Noto Sans', 'Noto Sans SC', 'Noto Sans Arabic', 'Noto Sans Hebrew', system-ui, -apple-system, sans-serif;
      font-display: swap;
    }
  </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-white">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:start-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-600 focus:text-white focus:rounded-md focus:shadow-lg">
    Skip to main content
  </a>

  <Header locale={locale} />

  <main id="main-content" class="flex-grow">
    <slot />
  </main>

  <Footer locale={locale} />
  <StickyBottomBar locale={locale} />

  <!-- Privacy-friendly lightweight click tracker (disabled by default) -->
  <script is:inline>
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-contact]');
      if (btn) {
        const channel = btn.getAttribute('data-contact');
        if (window.plausible) {
          window.plausible('ContactClick', { props: { channel } });
        } else if (window.umami) {
          window.umami.track('contact-click', { channel });
        }
      }
    });
  </script>
</body>
</html>
